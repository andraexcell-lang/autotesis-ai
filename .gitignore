# ============================================================================
# AutoTesis AI — gitignore
# Ditulis ulang sebagai UTF-8 murni (file lama tercampur UTF-16 sehingga
# pola *.cer / *.pfx / *.docx TIDAK aktif -> kunci privat nyaris ikut commit).
# ============================================================================

# === API Keys & Secrets ===
backend/llm_config.json
backend/.env
.env
*.pem
*.crt
*.cer
*.key
*.pfx
*.p12

# === Sertifikat & artefak lokal server ===
backend/server.pfx
backend/localhost.crt
backend/localhost.cer
backend/ca.cer
backend/_server.err
backend/log.txt
backend/*.log

# === Cache & Temporary ===
backend/_extraction_cache.json
backend/_trace_tmp/
backend/cache_*.json
backend/__pycache__/
__pycache__/
*.pyc
*.py[cod]
*$py.class

# === Variable Library (JSON per variabel) ===
backend/variable_library/*.json
!backend/variable_library/.gitkeep

# === Berkas uji / hasil generate ===
output/
*.xlsx
*.docx
backend/test_*.docx

# === Nilai env siap-tempel (berisi API key) ===
_render_env_values.txt

# === OS/IDE ===
.vscode/
.idea/
.DS_Store
Thumbs.db

